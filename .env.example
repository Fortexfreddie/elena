# Elena Backend — Environment Variables
# Copy this to .env and fill in the values.

# Server

# Port the NestJS server listens on (Cloud Run auto-sets this via $PORT)
PORT=3000

# Path to the error log file (used by log-monitor tool)
LOG_FILE_PATH=error.log

# Environment: development | production
NODE_ENV=development

# Process type: web (HTTP server) | worker (BullMQ consumer, no HTTP)
# Cloud Run worker service overrides this to "worker" via --set-env-vars
PROCESS_TYPE=web

# Telegram─

# Bot token from @BotFather — used by Grammy to call Telegram API
TELEGRAM_BOT_TOKEN=

# Random string you choose — Telegram sends it in X-Telegram-Bot-Api-Secret-Token header
# Set the same value when calling setWebhook. Used by TelegramSecretGuard to reject fakes.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Public base URL of your server (e.g. your ngrok/localtunnel URL or Cloud Run URL)
# Do NOT include the /webhook path, just the base URL (e.g., https://my-bot.loca.lt)
WEBHOOK_BASE_URL=

# Supabase PostgreSQL (Prisma)

# PrismaService selects the URL based on PROCESS_TYPE.
# Both are required — even if you only run `web` locally.

# Transaction Pooler URL — for web (serverless) instances
# Format: postgres://postgres.[ref]:[password]@[host]:6543/postgres
# Uses PgBouncer. connection_limit=1 because each Cloud Run instance is short-lived.
SUPABASE_WEB_URL=

# Direct connection URL — for the worker (long-running BullMQ consumer)
# Format: postgres://postgres.[ref]:[password]@[host]:5432/postgres
# connection_limit=5 matches BullMQ concurrency=10 (Prisma pools internally).
SUPABASE_WORKER_URL=

# Also set this for prisma migrate / prisma db push CLI commands
# (Prisma CLI reads DATABASE_URL, not our custom names)
SUPABASE_DATABASE_URL=

# Upstash Redis

# Full Redis URL with credentials — used by ioredis for BullMQ queues
# Format: rediss://default:[password]@[host]:6379
# Must be rediss:// (TLS). Plain redis:// won't connect to Upstash.
UPSTASH_REDIS_URL=

# REST API URL - used by @upstash/redis client
# Format: https://[host] (e.g. https://us1-primary-host.upstash.io)
UPSTASH_REDIS_REST_URL=

# REST API token — used by @upstash/redis client for hot memory + dedup gate
# Get this from the Upstash dashboard → REST API section
UPSTASH_REDIS_TOKEN=

# Qdrant Cloud (Vector DB)

# Qdrant cluster URL — used for warm memory (conversation embeddings)
# Format: https://[cluster-id].us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_URL=

# API key from Qdrant Cloud dashboard
QDRANT_API_KEY=

# Collection name for Elena's memory vectors (size=768, distance=Cosine)
# Create manually before first boot:
#   PUT /collections/elena-memory { "vectors": { "size": 768, "distance": "Cosine" } }
QDRANT_COLLECTION=elena-memory

# Google Gemini AI

# API key from Google AI Studio (https://aistudio.google.com/apikey)
# Used by GeminiService for all model calls + embeddings + file uploads
GEMINI_API_KEY=

# Langfuse (Observability)

# Get these from https://cloud.langfuse.com → Project Settings → Keys
# Used for audit trail: trace every agent call, tool execution, latency
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Encryption

# 32-byte hex key for AES-256-GCM encryption of user secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=

# Serper API (Web Search)
SERPER_API_KEY=
 
# Jina Reader API key for doc scraping (optional but recommended on shared hosting)
# Free tier: 10M tokens/month — get at jina.ai
# Without this key, requests are anonymous and share Render's IP pool
JINA_API_KEY=

# Pollinations.ai — fallback image generation (free tier at enter.pollinations.ai)
POLLINATIONS_API_KEY=

# GitHub (optional)─

# Read-only fine-grained PAT — used by github-fetch tool to read repos
# Scopes needed: Contents (read-only) on target repos
GITHUB_TOKEN=

# Google Cloud

# GCP project ID — used for Cloud Run deployment and Cloud Build
# Not the numeric project number. Example: elena-backend-123456
GCP_PROJECT_ID=

# Local Testing (Docker Compose)
# Required only if using the 'ngrok' service in docker-compose.yml
NGROK_AUTHTOKEN=
# Raw domain for the ngrok tunnel (NO https://)
NGROK_DOMAIN=